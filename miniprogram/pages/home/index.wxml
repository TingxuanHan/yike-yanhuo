<view class="page">
  <view class="brand"><text class="eyebrow">从家门口出发</text><text class="title">把日常，放回步行尺度</text></view>
  <view class="tabs"><button class="{{tab==='places'?'active':''}}" data-tab="places" bindtap="switchTab">地点簿</button><button class="{{tab==='journey'?'active':''}}" data-tab="journey" bindtap="switchTab">出行偏好</button><button class="{{tab==='connect'?'active':''}}" data-tab="connect" bindtap="switchTab">连接与同步</button></view>
  <view wx:if="error" class="error" role="alert">{{error}}</view><view wx:if="status" class="notice">{{status}}</view>
  <view wx:if="busy" class="notice">正在处理，请稍候。<button size="mini" bindtap="cancelAnalysis">取消正在进行的体检</button></view>
  <view wx:if="tab==='places'">
    <view class="section"><text class="heading">{{editing?'修改地点':'记住这个地方'}}</text><text class="muted">地图上没有的小店，也能留下入口与地标。仅主动选点时读取位置。</text>
      <button disabled="{{busy}}" bindtap="choose">选择小店入口位置</button><text class="muted">{{position?'位置已选择':'尚未选择位置'}}</text>
      <label>地点名称<input value="{{form.name}}" maxlength="80" data-key="form.name" bindinput="field" placeholder="例如：巷口修鞋铺" /></label>
      <label>详细地址<input value="{{form.address}}" maxlength="240" data-key="form.address" bindinput="field" /></label>
      <label>入口地标<input value="{{form.landmark}}" maxlength="300" data-key="form.landmark" bindinput="field" placeholder="例如：蓝色雨棚下" /></label>
      <label>出门提醒<input value="{{form.note}}" maxlength="300" data-key="form.note" bindinput="field" placeholder="营业时间、台阶等亲身了解的情况" /></label>
      <label>上次到访（可选）<picker mode="date" value="{{form.visitedOn}}" data-key="form.visitedOn" bindchange="field"><view class="picker">{{form.visitedOn || '点击选择日期'}}</view></picker></label>
      <button class="primary" disabled="{{busy}}" bindtap="remember">{{editing?'保存修改':'记住这个地方'}}</button>
    </view>
    <view class="section"><text class="heading">我的地点簿 · {{book.places.length}}处</text><text wx:if="!book.places.length" class="muted">先记录一处常去地点，也可以从Web配对同步。</text>
      <view wx:for="{{book.places}}" wx:key="id" class="place"><text class="place-name">{{item.name}}</text><text>{{item.address || '地址待补充'}}</text><text class="muted">{{item.position.system==='demo'?'模拟地点':'个人记录'}} {{item.visitedOn}}</text><view class="actions"><button size="mini" data-id="{{item.id}}" bindtap="card">大字指引</button><button size="mini" data-id="{{item.id}}" bindtap="edit" disabled="{{busy}}">修改</button><button size="mini" data-id="{{item.id}}" bindtap="remove" disabled="{{busy}}">移除</button></view><button data-id="{{item.id}}" bindtap="analyzePlace" disabled="{{busy}}">{{item.position.system==='demo'?'以此为起点模拟体检':'以此为起点百度体检（消耗额度）'}}</button></view>
      <button wx:if="undo" bindtap="undo" disabled="{{busy}}">撤销上次移除 / 合并</button><text class="muted">这些个人记录不会自动计入公共设施覆盖统计。</text>
    </view>
  </view>
  <view wx:if="tab==='journey'">
    <view class="section"><text class="heading">按自己的节奏出门</text>
      <label>步行时长（5—30分钟）<input type="number" value="{{book.preferences.minutes}}" data-key="minutes" bindinput="pref" /></label>
      <label>步速（0.3—2米/秒）<input type="digit" value="{{book.preferences.speedMps}}" data-key="speedMps" bindinput="pref" /></label><text class="muted">走100米用125秒，对应0.8米/秒。请按本人习惯填写。</text>
      <label>当地出发时间<picker mode="time" value="{{book.preferences.departure}}" data-key="departure" bindchange="pref"><view class="picker">{{book.preferences.departure}}</view></picker></label>
      <label class="switch">考虑等灯（手动假设）<switch checked="{{book.preferences.signals.enabled}}" data-key="enabled" bindchange="signal" color="#146c5d" /></label>
      <view wx:if="book.preferences.signals.enabled" class="signal"><text class="notice">初始值仅为演示假设。不是附近路口实测或实时行人信号灯。</text>
        <label>平均每公里路口数<input type="digit" value="{{book.preferences.signals.crossingsPerKm}}" data-key="crossingsPerKm" bindinput="signal" /></label>
        <label>平峰每次等待（秒）<input type="number" value="{{book.preferences.signals.offPeakSeconds}}" data-key="offPeakSeconds" bindinput="signal" /></label>
        <label>高峰每次等待（秒）<input type="number" value="{{book.preferences.signals.peakSeconds}}" data-key="peakSeconds" bindinput="signal" /></label>
        <label>早高峰开始<picker mode="time" value="{{book.preferences.signals.morningStart}}" data-key="morningStart" bindchange="signal"><view class="picker">{{book.preferences.signals.morningStart}}</view></picker></label>
        <label>早高峰结束<picker mode="time" value="{{book.preferences.signals.morningEnd}}" data-key="morningEnd" bindchange="signal"><view class="picker">{{book.preferences.signals.morningEnd}}</view></picker></label>
        <label>晚高峰开始<picker mode="time" value="{{book.preferences.signals.eveningStart}}" data-key="eveningStart" bindchange="signal"><view class="picker">{{book.preferences.signals.eveningStart}}</view></picker></label>
        <label>晚高峰结束<picker mode="time" value="{{book.preferences.signals.eveningEnd}}" data-key="eveningEnd" bindchange="signal"><view class="picker">{{book.preferences.signals.eveningEnd}}</view></picker></label>
      </view>
      <button bindtap="savePrefs" disabled="{{busy}}">保存偏好</button><button class="primary" bindtap="scenario" disabled="{{busy || !result}}">用当前报告试算（不调用百度）</button><button bindtap="demo" disabled="{{busy}}">体验模拟生活圈</button>
    </view>
    <view wx:if="result" class="section"><text class="heading">{{result.center.label}}</text><text class="muted">{{result.mode==='demo'?'模拟数据，不代表真实社区':'百度路线数据，营业与入口需核验'}}</text><text wx:if="result.scenario" class="notice">个人出行试算 · {{result.scenario.preferences.minutes}}分钟 · {{result.scenario.preferences.speedMps}}米/秒 · {{result.scenario.preferences.departure}}出发</text>
      <view wx:for="{{areas}}" wx:key="minutes" class="range"><text>{{item.minutes}}分钟</text><text>{{item.area}} km²</text><text class="muted">{{item.clipped?'触及采样边界，面积可能低估':'未触及采样边界'}}</text></view>
      <text class="muted">当前小程序展示面积与设施摘要，完整交互地图在Web工作台查看。</text>
      <view wx:for="{{nearby}}" wx:key="id" class="place"><text class="place-name">{{item.name}} · 约{{item.minutes}}分钟</text><text>{{item.address}}</text></view>
      <text wx:for="{{result.warnings}}" wx:key="*this" class="warning">· {{item}}</text><button bindtap="shareReport" disabled="{{busy || !connected}}">保存为共享报告</button>
    </view>
  </view>
  <view wx:if="tab==='connect'">
    <view class="section"><text class="heading">连接同一个私人地点簿</text><text class="muted">Web与小程序需使用同一服务器。配对码只交给信任的家人或协助者；配对设备都能修改内容。</text>
      <label>服务器地址<input value="{{server}}" data-key="server" bindinput="field" disabled="{{connected || busy}}" placeholder="https://你的服务器域名" /></label>
      <view wx:if="!connected"><label>Web生成的配对码<input value="{{code}}" maxlength="12" data-key="code" bindinput="field" /></label><button class="primary" bindtap="connect" disabled="{{busy || !code}}">使用配对码连接</button><label>创建邀请码（本机可留空）<input password value="{{invite}}" data-key="invite" bindinput="field" /></label><button bindtap="create" disabled="{{busy}}">创建私人地点簿</button></view>
      <view wx:else><text class="notice">已连接；本机修改需手动同步</text><button class="primary" bindtap="push" disabled="{{busy || revision===null || incoming}}">同步本机修改</button><button bindtap="pull" disabled="{{busy}}">读取服务器版本</button><button bindtap="pair" disabled="{{busy}}">生成配对码</button><view wx:if="pairCode" class="notice"><text selectable>配对码：{{pairCode}}</text><button size="mini" bindtap="copyPair">复制配对码</button></view><button bindtap="disconnect" disabled="{{busy}}">断开此设备</button></view>
      <view wx:if="incoming" class="notice"><text>服务器有{{incoming.book.places.length}}个地点，版本{{incoming.revision}}。本机尚未改动。</text><button bindtap="applyIncoming" disabled="{{busy}}">使用服务器版本（替换本机）</button><button bindtap="applyIncoming" data-merge="true" disabled="{{busy}}">合并到本机（冲突保留本机）</button></view>
      <button wx:if="undo" bindtap="undo" disabled="{{busy}}">撤销本机移除 / 合并</button>
    </view>
    <view wx:if="connected" class="section"><text class="heading">共享报告</text><button bindtap="loadReports" disabled="{{busy}}">读取共享报告</button><button wx:for="{{reports}}" wx:key="id" data-id="{{item.id}}" bindtap="openReport" disabled="{{busy}}">{{item.label}} · {{item.mode==='demo'?'模拟':'地图'}}报告</button></view>
  </view>
  <view wx:if="card" class="card-overlay"><scroll-view scroll-y class="card"><text class="eyebrow">出门带上这张卡</text><text class="card-title">我要去：{{card.name}}</text><text wx:if="card.position.system==='demo'" class="notice">模拟地点，仅用于演示</text><text class="muted">地址</text><text selectable>{{card.address || '请协助者补充地址'}}</text><text class="muted">认准这里</text><text selectable>{{card.landmark || '请协助者补充入口地标'}}</text><text class="muted">出门提醒</text><text>{{card.note || '出发前请确认营业情况'}}</text><text class="muted">由本人或协助者记录，不是逐路口导航。家属可在Web打印同一地点的指引。</text><button class="primary" bindtap="closeCard">收起指引</button></scroll-view></view>
</view>
