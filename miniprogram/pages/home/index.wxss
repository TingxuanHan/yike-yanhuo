.mode-switch {
  min-height: 88rpx;
  margin-bottom: 24rpx;
  color: #146c5d;
  font-size: 30rpx;
}
.simple-start .simple-entry {
  text-align: left;
  padding: 30rpx;
  margin: 24rpx 0;
  min-height: 164rpx;
  height: auto;
  white-space: normal;
}
.simple-start .simple-entry text {
  display: block;
  font-size: 42rpx;
  line-height: 1.6;
}
.simple-start .simple-entry .simple-caption {
  font-size: 30rpx;
  font-weight: 400;
}
.simple-start button {
  min-height: 104rpx;
  height: auto;
  font-size: 34rpx;
  line-height: 1.6;
  white-space: normal;
  padding: 20rpx;
}
.coverage-detail {
  margin-top: 24rpx;
}
.coverage-line {
  display: block;
  margin: 16rpx 0;
  line-height: 1.7;
}
.time-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 18rpx;
  font-size: 24rpx;
}
.legend-square {
  display: inline-block;
  width: 18rpx;
  height: 18rpx;
  margin-right: 8rpx;
  border: 1px solid #7d9088;
}
