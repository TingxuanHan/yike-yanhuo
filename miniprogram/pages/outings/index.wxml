<import src="/components/privacy.wxml" />
<view class="page outing-page {{careMode?'care-mode':''}}">
  <view class="outing-heading"><view><text class="eyebrow">把一次出门安排好</text><text class="title">出门办事</text></view><button class="secondary" bindtap="care">{{careMode?'标准字号':'大字模式'}}</button></view>
  <view class="outing-tabs"><button wx:for="{{tabs}}" wx:key="id" id="tab-{{item.id}}" data-tab="{{item.id}}" bindtap="tab" disabled="{{busy}}" class="{{tab===item.id?'active':''}}">{{item.label}}</button></view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}</view><view wx:if="{{status}}" class="notice" role="status">{{status}}</view><button wx:if="{{busy}}" bindtap="stop">停止计算</button>
  <view wx:if="{{tab!=='familiar'}}" class="section">
    <text class="eyebrow">{{demo?"离线示例 · 非真实街区":"当前真实报告"}}</text><text class="heading">{{label}}</text><button class="secondary" data-key="showSettings" bindtap="toggle" disabled="{{busy}}">{{prefs.departure}}出发 · {{prefs.speedMps}}米/秒 · {{showSettings?"收起设置":"修改"}}</button><view wx:if="{{showSettings}}"><view class="source-buttons"><button data-demo="true" bindtap="source" disabled="{{busy}}" class="{{demo?'primary':'secondary'}}">示例街区</button><button data-demo="false" bindtap="source" disabled="{{busy || !hasReal}}" class="{{!demo?'primary':'secondary'}}">当前真实报告</button></view>
    <text class="muted">{{demo?'地点、路线和核验记录均为人工构造。':'历史数据：'+date+'。入口和营业情况需另行核对。'}}</text>
    <view class="outing-fields"><label>出发时间<picker mode="time" value="{{prefs.departure}}" data-key="prefs.departure" bindchange="field" disabled="{{busy}}"><view class="picker">{{prefs.departure}}</view></picker></label><label>步速（米/秒）<input type="digit" value="{{prefs.speedMps}}" data-key="prefs.speedMps" data-number="true" bindinput="field" disabled="{{busy}}"/></label></view><text class="muted">{{prefs.signals.enabled?'沿用出行偏好的等灯假设，未接入实时行人信号。':'未计入等灯。可在“我的”出行偏好中设置等待假设。'}}</text></view>
  </view>
  <view wx:if="{{tab==='errands'}}">
    <button class="primary" id="shopping-entry" bindtap="shopping" disabled="{{busy}}">顺路好买 · 按清单与预算安排</button>
    <view class="section"><text class="heading">这趟想做什么</text><label>出门到回来的总时间（分钟）<input type="number" value="{{budget}}" data-key="budget" data-number="true" bindinput="field" disabled="{{busy}}"/></label>
      <view class="task-row" wx:for="{{taskRows}}" wx:key="id"><button data-index="{{index}}" bindtap="task" disabled="{{busy}}" class="{{item.checked?'primary':'secondary'}}">{{item.checked?'✓ ':''}}{{item.label}}</button><label wx:if="{{item.checked}}">停留（分钟）<input type="number" value="{{item.stay}}" data-index="{{index}}" bindinput="stay" disabled="{{busy}}"/></label></view>
      <text class="muted">最多三件事，每件事比较最多两处地点，整趟最多五处候选。</text>
      <button class="secondary" data-key="showOpenings" bindtap="toggle" disabled="{{busy}}">{{showOpenings?"收起":"查看"}}候选地点与营业时间</button><view wx:if="{{showOpenings}}"><view class="candidate" wx:for="{{candidates}}" wx:key="id"><text class="place-name">{{item.name}}</text><view class="outing-fields"><label>开门（选填）<picker mode="time" value="{{item.open}}" data-key="open" data-index="{{index}}" bindchange="window" disabled="{{busy}}"><view class="picker">{{item.open || '未确认'}}</view></picker></label><label>关门（选填）<picker mode="time" value="{{item.close}}" data-key="close" data-index="{{index}}" bindchange="window" disabled="{{busy}}"><view class="picker">{{item.close || '未确认'}}</view></picker></label></view><button wx:if="{{item.open || item.close}}" data-index="{{index}}" bindtap="clearWindow" disabled="{{busy}}" class="secondary">清空营业时间</button></view>
      </view><text class="muted">所填营业时间只用于本次计划。时间不足时会给出可完成的部分任务。</text><button class="primary" id="errand-submit" bindtap="errands" disabled="{{busy}}">安排这趟出门</button>
    </view>
    <view class="section outing-result" wx:for="{{plans}}" wx:key="index"><text wx:if="{{demo}}" class="eyebrow">离线示例 · 非真实街区</text><text class="eyebrow">{{index===0?'优先方案':'另一种走法'}}</text><text class="heading">{{item.summary}}</text><text>{{item.detail}}</text><view class="timeline"><text wx:for="{{item.rows}}" wx:for-item="row" wx:key="*this">{{row}}</text></view><text class="muted" wx:for="{{item.notes}}" wx:for-item="note" wx:key="*this">{{note}}</text></view>
  </view>
  <view wx:if="{{tab==='rest'}}">
    <view class="section"><text class="heading">找一条能歇脚的路</text><text class="muted">从出发点去目的地，最多比较三个已核验休息点。到期后不参与推荐。</text><label>目的地<picker range="{{targetNames}}" value="{{targetIndex}}" bindchange="target" disabled="{{busy}}"><view class="picker">{{targetNames[targetIndex] || '暂无目的地'}}</view></picker></label><label>每次最多连续走（分钟）<input type="number" value="{{continuous}}" data-key="continuous" data-number="true" bindinput="field" disabled="{{busy}}"/></label><label>每站休息（分钟）<input type="number" value="{{restMinutes}}" data-key="restMinutes" data-number="true" bindinput="field" disabled="{{busy}}"/></label>
      <button wx:for="{{restRows}}" wx:key="id" data-id="{{item.id}}" bindtap="restToggle" disabled="{{busy || item.expired}}" class="{{item.checked?'primary':'secondary'}}">{{item.checked?'✓ ':''}}{{item.name}} · {{item.expired?'已到期':'有效至'+item.validUntil}}</button><text wx:if="{{!restRows.length}}" class="muted">还没有休息点，可先体验示例或从地点簿添加。</text><button class="primary" id="rest-submit" bindtap="restJourney" disabled="{{busy}}">找能歇脚的走法</button>
    </view>
    <view class="section outing-result" wx:for="{{restPlans}}" wx:key="index"><text class="eyebrow">{{demo?"离线示例 · ":""}}连续步行上限{{continuous}}分钟</text><text class="heading">{{item.summary}}</text><text>{{item.detail}}</text><view class="timeline"><text wx:for="{{item.rows}}" wx:for-item="row" wx:key="*this">{{row}}</text></view></view>
    <view class="section"><text class="heading">登记能休息的地方</text><text class="muted">请先确认现场有可用座位。这里只保存本人的核验记录。</text><label>私人地点簿中的位置<picker range="{{placeNames}}" value="{{placeIndex}}" bindchange="place" disabled="{{busy}}"><view class="picker">{{placeNames[placeIndex] || '先到地点簿记录位置'}}</view></picker></label><label>实际核验日期<picker mode="date" value="{{restChecked}}" data-key="restChecked" bindchange="field" disabled="{{busy}}"><view class="picker">{{restChecked}}</view></picker></label><label>有效至（最长90天）<picker mode="date" value="{{restUntil}}" data-key="restUntil" bindchange="field" disabled="{{busy}}"><view class="picker">{{restUntil}}</view></picker></label><label>座位位置与开放提醒<input maxlength="300" value="{{restNote}}" data-key="restNote" bindinput="field" disabled="{{busy}}"/></label><button bindtap="saveRest" disabled="{{busy || !placeNames.length}}">确认可休息并保存</button><view wx:for="{{restList}}" wx:key="id" class="place"><text>{{item.name}} · {{item.validUntil}}</text><button class="secondary" data-id="{{item.id}}" bindtap="deleteRest" disabled="{{busy}}">移除休息点</button></view></view>
  </view>
  <view wx:if="{{tab==='impact'}}">
    <view class="section"><text class="heading">假设这里多一处服务</text><label>比较哪类设施<picker range="{{impactCategories}}" range-key="label" value="{{impactCategoryIndex}}" bindchange="category" disabled="{{busy}}"><view class="picker">{{impactCategories[impactCategoryIndex].label}}</view></picker></label><label>新增候选位置<picker range="{{newNames}}" value="{{newIndex}}" bindchange="newPlace" disabled="{{busy}}"><view class="picker">{{newNames[newIndex] || '请先在地点簿记录候选位置'}}</view></picker></label><label>步行时间门槛（分钟）<input type="number" value="{{prefs.minutes}}" data-key="prefs.minutes" data-number="true" bindinput="field" disabled="{{busy}}"/></label><text>现有对照设施：{{baselineNames}}</text><text class="muted">比较{{sampleCount}}个固定测试点。这是规划假设，不会改变原始体检，也不代表受益人数或真实开业。</text><button class="primary" id="impact-submit" bindtap="impact" disabled="{{busy}}">比较补点前后</button></view>
    <view class="section outing-result" wx:if="{{impact}}"><text class="eyebrow">{{demo?"离线示例 · ":""}}{{prefs.minutes}}分钟门槛 · 假设补点</text><text class="heading">新增覆盖 {{impact.newlyCovered}}/{{impact.rows.length}} 个测试点</text><text>{{impact.improved}}个点步行时间缩短，{{impact.unknown}}个点资料不足。</text><text class="muted">有完整对照的点，平均节省{{impact.averageSavedText}}。</text><view class="place" wx:for="{{impact.rows}}" wx:key="id"><text class="place-name">{{item.name}} {{item.gain?'· 新覆盖':''}}</text><text>所选现有设施：{{item.beforeText}}</text><text>增加候选后：{{item.afterText}}</text></view><text class="muted">结论只针对所列设施与测试点，不是整个社区的覆盖率。</text></view>
  </view>
  <view wx:if="{{tab==='familiar'}}">
    <button wx:if="{{!showRouteEditor && !card}}" bindtap="continueDraft">添加或继续编辑熟路</button><view wx:if="{{showRouteEditor && !card}}" class="section"><text class="heading">留下家人认得出的关键点</text><text class="muted">按走路顺序记录2—8个关键点，照片和文字可离线查看。卡片不自动判断当前位置。</text><label>熟路名称<input maxlength="80" value="{{routeName}}" data-key="routeName" bindinput="field" disabled="{{busy}}"/></label><label>实际走访日期<picker mode="date" value="{{checkedOn}}" data-key="checkedOn" bindchange="field" disabled="{{busy}}"><view class="picker">{{checkedOn}}</view></picker></label>
      <view class="step-editor" wx:for="{{steps}}" wx:key="index"><text class="heading">第{{index+1}}个关键点</text><label>认准哪里<input maxlength="80" value="{{item.title}}" data-key="title" data-index="{{index}}" bindinput="step" disabled="{{busy}}"/></label><label>到这里怎么走<textarea maxlength="300" auto-height value="{{item.instruction}}" data-key="instruction" data-index="{{index}}" bindinput="step" disabled="{{busy}}"/></label><image wx:if="{{item.photo}}" src="{{item.photo}}" mode="widthFix" class="route-photo"/><button data-index="{{index}}" bindtap="photo" disabled="{{busy}}">{{item.photo?'更换照片':'添加地标照片'}}</button><button wx:if="{{item.photo}}" data-index="{{index}}" bindtap="removePhoto" disabled="{{busy}}">移除照片</button><view class="step-actions"><button data-index="{{index}}" data-offset="-1" bindtap="moveStep" disabled="{{busy || index===0}}">上移</button><button data-index="{{index}}" data-offset="1" bindtap="moveStep" disabled="{{busy || index===steps.length-1}}">下移</button><button data-index="{{index}}" bindtap="removeStep" disabled="{{busy}}">移除</button></view></view>
      <button bindtap="addStep" disabled="{{busy || steps.length>=8}}">添加关键点</button><button class="primary" bindtap="saveRoute" disabled="{{busy}}">保存熟路卡</button><button class="secondary" bindtap="newRoute" disabled="{{busy}}">新建另一条</button>
    </view>
    <view wx:if="{{!card}}" class="section" wx:for="{{routeList}}" wx:key="id"><text class="heading">{{item.name}}</text><text>{{item.count}}个关键点 · {{item.checkedOn}}走访</text><button class="primary" data-id="{{item.id}}" bindtap="openRoute" disabled="{{busy}}">查看熟路卡</button><view class="step-actions"><button data-id="{{item.id}}" bindtap="editRoute" disabled="{{busy}}">编辑</button><button data-id="{{item.id}}" bindtap="deleteRoute" disabled="{{busy}}">移除</button></view></view>
    <view wx:if="{{card}}" class="section familiar-card"><button bindtap="closeCard" class="secondary">返回熟路列表</button><text class="eyebrow">{{card.name}} · {{card.checkedOn}}走访</text><text class="step-count">第 {{cardIndex+1}} / {{card.count}} 步</text><text class="heading">{{cardStep.title}}</text><image wx:if="{{cardStep.photo}}" src="{{cardStep.photo}}" mode="widthFix" class="route-photo"/><text class="route-instruction">{{cardStep.instruction}}</text><view class="step-actions"><button data-offset="-1" bindtap="cardNext" disabled="{{cardIndex===0}}">上一步</button><button data-offset="1" bindtap="cardNext" disabled="{{cardIndex===card.count-1}}" class="primary">下一步</button></view><text class="muted">请以现场道路与过街指示为准。</text><button bindtap="copyRoute">复制整条熟路文字</button></view>
  </view>
  <button wx:if="{{hasUndo}}" bindtap="undoRestore" disabled="{{busy}}">撤销移除</button>
  <template is="privacy-dialog" data="{{showPrivacy,privacyError}}" />
</view>
