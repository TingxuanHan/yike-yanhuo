<view class="page shopping-page {{careMode?'care-mode':''}}">
  <view class="shopping-heading"><view><text class="eyebrow">带上清单再出门</text><text class="title">顺路好买</text></view><button class="secondary" bindtap="care">{{careMode?'标准字号':'大字模式'}}</button></view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
  <block wx:if="{{ready}}">
  <view class="section source"><text class="eyebrow">{{label}}</text><view class="row"><button class="{{demo?'primary':'secondary'}}" data-demo="true" bindtap="mode" disabled="{{busy}}">示例店铺</button><button class="{{!demo?'primary':'secondary'}}" data-demo="false" bindtap="mode" disabled="{{busy}}">我的真实记录</button></view><text class="muted">{{modeNotice}}</text></view>
  <view class="tabs"><button id="shopping-list-tab" class="{{tab==='list'?'active':''}}" data-tab="list" bindtap="tab" disabled="{{busy}}">购物清单</button><button id="shopping-prices-tab" class="{{tab==='prices'?'active':''}}" data-tab="prices" bindtap="tab" disabled="{{busy}}">价格记忆</button></view>
  <view wx:if="{{status}}" class="notice" role="status">{{status}}</view><button wx:if="{{undo}}" class="secondary" bindtap="undo">撤销移除</button><button wx:if="{{busy}}" bindtap="stop">停止读取后续路线</button>
  <block wx:if="{{tab==='list'}}">
    <view class="section"><text class="heading">这次要买什么</text><text wx:if="{{!items.length}}" class="muted">添加商品，或到价格记忆中选用买过的商品。</text>
      <view class="shopping-item" wx:for="{{items}}" wx:key="id">
        <view class="item-heading"><view><text class="place-name">{{item.name || '待填写商品'}}</text><text class="muted">{{item.spec}} · {{item.quantity}}{{item.unit}}{{item.brand?' · '+item.brand:''}}</text></view><button class="secondary small" data-id="{{item.id}}" bindtap="editItem" disabled="{{busy}}">{{editItem===item.id?'收起':'编辑'}}</button></view>
        <view wx:if="{{editItem===item.id}}"><button class="secondary small" data-index="{{index}}" bindtap="removeItem" disabled="{{busy}}">移除这件商品</button>
        <view class="row"><label>商品名称<input value="{{item.name}}" maxlength="60" data-index="{{index}}" data-key="name" bindinput="item" disabled="{{busy}}"/></label><label>可比规格<input value="{{item.spec}}" maxlength="80" placeholder="例如：6枚装" data-index="{{index}}" data-key="spec" bindinput="item" disabled="{{busy}}"/></label></view>
        <view class="row"><label>数量<input type="number" value="{{item.quantity}}" data-index="{{index}}" data-key="quantity" bindinput="item" disabled="{{busy}}"/></label><label>单位<input value="{{item.unit}}" maxlength="12" data-index="{{index}}" data-key="unit" bindinput="item" disabled="{{busy}}"/></label></view>
        <label>品牌（选填）<input value="{{item.brand}}" maxlength="40" data-index="{{index}}" data-key="brand" bindinput="item" disabled="{{busy}}"/></label>
        <button class="secondary choice" data-index="{{index}}" bindtap="alternative" disabled="{{busy}}">{{item.alternatives?'✓ 接受同规格的其他品牌':'品牌按清单匹配 · 点此允许其他品牌'}}</button>
        </view>
      </view>
      <view class="row"><button class="secondary" bindtap="addItem" disabled="{{busy || items.length>=5}}">添加商品</button><button class="secondary" id="shopping-save-list" bindtap="saveList" disabled="{{busy}}">保存清单和预算</button></view><button class="secondary" bindtap="loadList" disabled="{{busy}}">载入保存的清单</button>
    </view>
    <view class="section"><text class="heading">这一趟的安排</text><view class="row"><label>消费预算（元）<input type="digit" value="{{options.money}}" data-key="money" bindinput="field" disabled="{{busy}}"/></label><label>整趟时间（分钟）<input type="number" value="{{options.minutes}}" data-key="minutes" bindinput="field" disabled="{{busy}}"/></label></view>
      <view class="row"><label>最多到几家店<picker range="{{shopCounts}}" value="{{options.maxShops-1}}" data-kind="count" bindchange="select" disabled="{{busy}}"><view class="picker">{{options.maxShops}}家</view></picker></label><label>均衡方案多用几分钟<input type="number" value="{{options.detour}}" data-key="detour" bindinput="field" disabled="{{busy}}"/></label></view>
      <text class="muted">时间包含购物停留和返程。缺价不按0元计算。</text>
      <button class="secondary" data-key="showSettings" bindtap="toggle" disabled="{{busy}}">{{showSettings?'收起':'展开'}}出发与休息设置</button>
      <view wx:if="{{showSettings}}"><label>出发点<picker range="{{origins}}" range-key="name" value="{{originIndex}}" data-kind="origin" bindchange="select" disabled="{{busy}}"><view class="picker">{{origins[originIndex].name || '先在地点簿记录出发点'}}</view></picker></label><view class="row"><label>出发时刻<picker mode="time" value="{{prefs.departure}}" data-key="departure" bindchange="field" disabled="{{busy}}"><view class="picker">{{prefs.departure}}</view></picker></label><label>步速（米/秒）<input type="digit" value="{{prefs.speedMps}}" data-key="speedMps" bindinput="field" disabled="{{busy}}"/></label></view>
      <view class="row"><label>每店停留（分钟）<input type="number" value="{{options.stay}}" data-key="stay" bindinput="field" disabled="{{busy}}"/></label><label>连续步行上限<input type="number" value="{{options.continuous}}" data-key="continuous" bindinput="field" disabled="{{busy}}"/></label></view><text class="muted">连续步行填0表示不限；逛店与等灯不算坐下休息。</text><label>核验过的休息点<picker range="{{restOptions}}" range-key="name" value="{{restIndex}}" data-kind="rest" bindchange="select" disabled="{{busy}}"><view class="picker">{{restOptions[restIndex].name}}</view></picker></label><label>休息多久（分钟）<input type="number" value="{{options.rest}}" data-key="rest" bindinput="field" disabled="{{busy}}"/></label><text class="muted">{{prefs.signals.enabled?'等灯沿用出行偏好中的假设。':'当前未计入等灯，可在我的出行偏好中设置。'}}</text></view>
      <button class="secondary" bindtap="stores" disabled="{{busy}}">{{showStores?'收起':'查看'}}候选店 · 已选{{selectedCount}}家</button>
      <view wx:if="{{showStores}}"><text class="muted">最多比较5家；使用休息点时最多4家。</text><view class="store-row" wx:for="{{stores}}" wx:key="id"><button class="{{item.checked?'primary':'secondary'}}" data-id="{{item.id}}" bindtap="store" disabled="{{busy}}">{{item.checked?'✓ ':''}}{{item.name}}</button><view class="row"><label>开门（选填）<picker mode="time" value="{{item.open}}" data-id="{{item.id}}" data-key="open" bindchange="opening" disabled="{{busy}}"><view class="picker">{{item.open || '未确认'}}</view></picker></label><label>关门（选填）<picker mode="time" value="{{item.close}}" data-id="{{item.id}}" data-key="close" bindchange="opening" disabled="{{busy}}"><view class="picker">{{item.close || '未确认'}}</view></picker></label></view><button wx:if="{{item.open || item.close}}" class="secondary" data-id="{{item.id}}" bindtap="clearOpening" disabled="{{busy}}">清空营业时间</button></view></view>
      <button class="primary" id="shopping-calculate" bindtap="calculate" disabled="{{busy}}">比较购物方案</button>
    </view>
    <view class="section shopping-result" wx:for="{{plans}}" wx:key="id" wx:for-item="plan" wx:for-index="planIndex"><text class="eyebrow">{{demo?'离线示例 · 虚构价格':'私人记录 · 价格与库存待核实'}}</text><text class="heading">{{plan.title}}</text><text class="total">{{plan.cost}}</text><text>{{plan.total}}</text><text>{{plan.coverage}} · {{plan.budget}}</text><text wx:if="{{plan.comparison}}" class="comparison">{{plan.comparison}}</text><view class="timeline"><view wx:for="{{plan.rows}}" wx:key="id" wx:for-item="row"><text class="place-name">{{row.title}}</text><text wx:if="{{row.buy}}">{{row.buy}}</text><text class="muted">{{row.detail}}</text></view></view><button class="secondary" data-id="{{plan.id}}" bindtap="notes">推荐依据与待确认信息</button><view wx:if="{{openNotes===plan.id}}"><text class="muted" wx:for="{{plan.notes}}" wx:key="*this" wx:for-item="note">{{note}}</text></view><text class="muted">这里显示到店顺序，不是逐路口导航。</text><view class="row"><button class="secondary" data-index="{{planIndex}}" bindtap="copy">复制购物安排</button><button class="secondary" data-tab="prices" bindtap="tab">买完补记价格</button></view><button class="secondary" id="movement-trip-{{planIndex}}" data-index="{{planIndex}}" bindtap="movement">这趟顺路动一动</button></view>
  </block>
  <block wx:if="{{tab==='prices'}}"><text class="muted">记住买过的价格，下次更好安排。</text><button class="primary" id="shopping-new-price" bindtap="newPrice">记一笔价格</button>
    <view class="section"><label>查找商品或店铺<input value="{{priceQuery}}" placeholder="商品名、规格或店名" data-key="priceQuery" bindinput="field"/></label></view>
    <view wx:if="{{showEditor}}" class="section price-editor"><text class="heading">补记商品或消费参考</text><label>哪家店<picker range="{{stores}}" range-key="name" value="{{storeIndex}}" data-kind="store" bindchange="select"><view class="picker">{{stores[storeIndex].name || '先在地点簿保存店铺'}}</view></picker></label><label>记录类型<picker range="{{kinds}}" range-key="name" value="{{kindIndex}}" data-kind="kind" bindchange="select"><view class="picker">{{kinds[kindIndex].name}}</view></picker></label>
      <view class="row"><label>商品 / 服务名称<input value="{{form.name}}" maxlength="60" data-key="name" bindinput="form"/></label><label>规格 / 套餐说明<input value="{{form.spec}}" maxlength="80" data-key="spec" bindinput="form"/></label></view><view class="row"><label>计价单位<input value="{{form.unit}}" maxlength="12" data-key="unit" bindinput="form"/></label><label>品牌（选填）<input value="{{form.brand}}" maxlength="40" data-key="brand" bindinput="form"/></label></view>
      <view class="row"><label>单价 / 区间下限<input type="digit" value="{{form.low}}" placeholder="未知留空" data-key="low" bindinput="form"/></label><label>上限（空白为同价）<input type="digit" value="{{form.high}}" data-key="high" bindinput="form"/></label></view><view class="row"><label>记录日期<picker mode="date" value="{{form.observedOn}}" data-key="observedOn" bindchange="form"><view class="picker">{{form.observedOn}}</view></picker></label><label>参考有效天数<input type="number" value="{{form.validDays}}" data-key="validDays" bindinput="form"/></label></view>
      <label>价格来源<picker range="{{sources}}" range-key="name" value="{{sourceIndex}}" data-kind="source" bindchange="select"><view class="picker">{{sources[sourceIndex].name}}</view></picker></label><label>当时的情况<picker range="{{stocks}}" range-key="name" value="{{stockIndex}}" data-kind="stock" bindchange="select"><view class="picker">{{stocks[stockIndex].name}}</view></picker></label><button class="secondary" bindtap="like">{{form.liked?'✓ 这款用过满意':'标记这款用过满意'}}</button><text class="muted">每人、每次消费仅作店铺参考，不叠加到购物清单。</text><button class="primary" id="shopping-save-price" bindtap="savePrice">保存价格记录</button><button class="secondary" data-key="showEditor" bindtap="toggle">收起，保留草稿</button>
    </view>
    <view wx:if="{{!prices.length}}" class="section"><text>{{priceQuery ? '没有找到匹配的商品或店铺，换个关键词试试。' : '还没有价格记忆。先记一笔实际购买或看到的标价，再把商品加入清单。'}}</text></view>
    <view class="section price-record" wx:for="{{prices}}" wx:key="id"><text class="eyebrow">{{demo?'模拟店铺':'私人价格记录'}} · {{item.store}}</text><text class="place-name">{{item.title}}</text><text class="price">{{item.price}}</text><text class="muted">{{item.detail}}{{item.liked?' · 用过满意':''}}</text><view class="row"><button wx:if="{{item.item}}" class="secondary" data-id="{{item.id}}" bindtap="usePrice" disabled="{{item.blocked}}">加入清单</button><button class="secondary" data-id="{{item.id}}" bindtap="reprice">补记实付 / 缺货</button></view><view class="row"><button wx:if="{{item.item}}" class="secondary" data-id="{{item.id}}" bindtap="block">{{item.blocked?'恢复推荐':'不再推荐此商品'}}</button><button wx:if="{{item.removable}}" class="secondary" data-id="{{item.id}}" bindtap="removePrice">移除记录</button></view></view>
  </block>
  </block>
</view>
