.movement-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 12rpx 0 28rpx;
}
.movement-heading button {
  margin: 0;
  font-size: 26rpx;
}
.movement-page button {
  min-height: 88rpx;
  white-space: normal;
  word-break: break-word;
  line-height: 1.5;
  padding: 20rpx 16rpx;
}
.movement-page input {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  height: 88rpx;
  min-height: 88rpx;
}
.modes {
  display: flex;
  gap: 12rpx;
}
.modes > button {
  flex: 1;
  min-width: 0;
}
.movement-source {
  border-left: 6rpx solid #146c5d;
}
.route,
.total,
.goal {
  display: block;
  margin: 20rpx 0;
}
.total {
  font-size: 40rpx;
  font-weight: 650;
}
.goal {
  padding-bottom: 22rpx;
  border-bottom: 2rpx dashed #a9bdb5;
}
.movement-result {
  border-top: 8rpx solid #146c5d;
  border-radius: 0 0 18rpx 18rpx;
}
.leg {
  margin-top: 26rpx;
  border-top: 2rpx solid #dce6e2;
  padding-top: 24rpx;
}
.phase {
  border-left: 6rpx solid #88bca5;
  padding: 20rpx;
  margin: 16rpx 0;
  background: #f4f8f7;
}
.phase.brisk {
  border-color: #146c5d;
}
.phase.wait {
  border-color: #c46136;
}
.care-mode .modes {
  flex-direction: column;
  gap: 0;
}
.care-mode input {
  height: 104rpx;
  min-height: 104rpx;
}
.care-mode .total {
  font-size: 44rpx;
}
