.trip-page {
  padding: 28rpx 24rpx 80rpx;
  color: #243f48;
  background: #f4f8f7;
  font-size: 30rpx;
  line-height: 1.6;
}
.heading {
  position: relative;
  padding: 12rpx 0 24rpx;
}
.title {
  display: block;
  font-size: 48rpx;
  font-weight: 650;
  margin: 12rpx 0;
}
.eyebrow {
  display: block;
  font-size: 26rpx;
  color: #146c5d;
}
.h3 {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  margin: 12rpx 0;
}
.trip-page .card {
  height: auto;
  font-size: inherit;
  padding: 28rpx;
  border: 1px solid #d5e3df;
  border-radius: 20rpx;
  background: white;
  margin: 24rpx 0;
}
.note {
  display: block;
  color: #64777c;
  font-size: 27rpx;
  margin: 10rpx 0;
}
.metric {
  display: block;
  font-variant-numeric: tabular-nums;
  color: #146c5d;
  font-weight: 600;
}
.error,
.status {
  display: block;
  margin: 16rpx 0;
  padding: 16rpx;
  border-radius: 12rpx;
}
.error {
  color: #a24625;
  background: #fff1e8;
}
.status {
  color: #146c5d;
  background: #e9f2ed;
}
button {
  min-height: 88rpx;
  font-size: 30rpx;
  line-height: 1.5;
  padding: 20rpx 16rpx;
  box-sizing: border-box;
  margin: 12rpx 0;
  color: #146c5d;
  background: #edf4f0;
}
.primary {
  color: white;
  background: #146c5d;
}
.actions {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.actions button {
  flex: 1;
  min-width: 180rpx;
}
.check {
  display: flex;
  gap: 12rpx;
  align-items: center;
  min-height: 88rpx;
  padding: 8rpx 0;
}
.check text {
  flex: 1;
}
label {
  display: block;
  margin: 20rpx 0;
}
input,
textarea {
  box-sizing: border-box;
  background: #f5f8f7;
  border: 1px solid #c8d9d3;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 30rpx;
  width: 100%;
  min-height: 88rpx;
  margin: 8rpx 0;
}
textarea {
  min-height: 140rpx;
}
.stop {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
}
.stop > view {
  flex: 1;
  border-left: 3rpx solid #c8dfd6;
  padding-left: 20rpx;
}
.time {
  width: 110rpx;
  font-variant-numeric: tabular-nums;
  color: #146c5d;
}
.diff {
  padding: 20rpx;
  background: #edf4f0;
  border-left: 6rpx solid #146c5d;
}
.active > button {
  min-height: 112rpx;
  font-size: 34rpx;
}
.care {
  font-size: 38rpx;
}
.care .note,
.care .eyebrow {
  font-size: 32rpx;
}
.trip-page.care button,
.trip-page.care input,
.trip-page.care textarea {
  font-size: 36rpx;
}
.care .h3 {
  font-size: 42rpx;
}
.assist-panel {
  border-left: 8rpx solid #146c5d;
}
.entrance-mark {
  position: relative;
  margin: 24rpx 0;
}
.entrance-mark image {
  width: 100%;
  display: block;
  border-radius: 16rpx;
}
.entrance-mark .entrance-pin {
  margin: 0;
  position: absolute;
  transform: translate(-50%, -50%);
  border: 4rpx solid white;
  box-sizing: border-box;
  border-radius: 50%;
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #a44720;
  color: white;
  font-size: 23rpx;
  box-shadow: 0 0 0 2rpx #a44720;
  pointer-events: none;
}
.departure-place {
  padding: 24rpx 0;
  border-top: 1rpx solid #dce8e3;
}
.departure-place > text {
  display: block;
  margin: 10rpx 0;
}
.departure-photo {
  position: relative;
  max-width: 600rpx;
}
.departure-photo image {
  display: block;
  width: 100%;
  border-radius: 20rpx;
}
.departure-marker {
  position: absolute;
  transform: translate(-50%, -50%);
  width: 50rpx;
  line-height: 50rpx;
  text-align: center;
  border: 3rpx solid white;
  border-radius: 50%;
  color: white;
  background: #8b3500;
}
