<view wx:if="{{active}}" class="card assist-panel">
  <text class="h3">家人帮我一下</text><text wx:if="{{assistance.error}}" class="error">{{assistance.error}}</text><text wx:if="{{assistance.status}}" class="status">{{assistance.status}}</text>
  <block wx:if="{{!assistance.view}}"><label><text>想让家人帮什么</text><textarea value="{{helpRequest}}" maxlength="240" bindinput="helpRequest" auto-height/></label><button class="primary" disabled="{{assistance.busy || active.phase === 'finished'}}" bindtap="startHelp">发起这趟的远程协助</button><text class="note">先在“我的”连接服务。发起后将协助卡发给家人，只分享这趟地点名称和进度；照片另行选择分享。</text><button bindtap="restoreHelp" disabled="{{assistance.busy}}">恢复已有协助</button></block>
  <block wx:else>
    <text>本次协助到{{helpExpires}}结束，只有你确认后才会修改安排。</text><button class="primary" open-type="share" disabled="{{!assistance.invite}}">发给信任的家人</button><button bindtap="copyHelp" disabled="{{!assistance.invite}}">复制家人可用的Web链接</button><text wx:if="{{helpCopy}}" class="status">{{helpCopy}}</text><text class="note">链接持有人可以查看并提出建议，请只发给信任的人。本机地址只能演示，跨设备需可访问的HTTPS服务。</text>
    <view class="actions"><button bindtap="refreshHelp" disabled="{{assistance.busy}}">刷新家人的建议</button><button bindtap="endHelp" disabled="{{assistance.busy}}">结束协助</button></view><text class="note">页面打开时约每5秒更新，最后同步{{helpUpdated}}。当前位置由你手动确认。</text>
    <view wx:if="{{assistance.view.proposal}}" class="diff"><text class="h3">{{assistance.view.proposal.helper}}的建议</text><text>{{assistance.view.proposal.note}}</text><view wx:if="{{assistance.view.proposal.kind === 'entrance' && assistance.view.snapshot.guide}}" class="entrance-mark"><image src="{{assistance.view.snapshot.guide.photo}}" mode="widthFix"/><text class="entrance-pin" style="left:{{suggestionX}}%;top:{{suggestionY}}%;">入口</text></view><text wx:for="{{helpChanges}}" wx:key="*this" class="note">{{item}}</text><button class="primary" bindtap="acceptHelp" disabled="{{assistance.busy}}">核对并采纳建议</button><button bindtap="rejectHelp" disabled="{{assistance.busy}}">保留我的安排</button></view>
  </block>
  <button bindtap="phonePanel">给家人打电话</button><view wx:if="{{showPhone}}"><label><text>家人电话（只保存在本机）</text><input value="{{helpPhone}}" type="text" maxlength="20" bindinput="phone"/></label><button bindtap="callFamily">拨打家人电话</button></view>
  <button bindtap="editRemaining">{{showAdjust ? '收起调整' : '调整剩余行程'}}</button>
  <view wx:if="{{showAdjust && adjust}}"><text class="note">到达并确认后，可取消或调换尚未去的站点。已到达记录保留，返程自动加入。</text><view wx:for="{{adjustChoices}}" wx:key="id" class="check" data-id="{{item.id}}" bindtap="adjustStop"><checkbox checked="{{item.checked}}"/><text>{{item.name}}</text></view><view wx:for="{{adjustOrdered}}" wx:key="id"><text>{{index + 1}}. {{item.name}}</text><button data-id="{{item.id}}" bindtap="moveStop" disabled="{{item.first}}">提前一站</button></view><label><text>这次舒适步速（米/秒）</text><input value="{{adjust.speed}}" type="digit" bindinput="adjustSpeed"/></label><button bindtap="previewRemaining" disabled="{{active.phase !== 'at'}}">先核算调整结果</button><view wx:if="{{adjustPreview.length}}" class="diff"><text wx:for="{{adjustPreview}}" wx:key="*this" class="note">{{item}}</text><button class="primary" bindtap="applyRemaining">确认更新剩余行程</button></view></view>
  <button bindtap="showEntrance">{{entranceOpen ? '收起入口卡' : '最后一百米 · 认准入口'}}</button>
  <view wx:if="{{entranceOpen}}"><text class="note">选择入口所属地点，照片与说明先保存在私人地点簿。</text><view class="actions"><button wx:for="{{entrancePlaces}}" wx:key="id" class="{{entrance.id === item.id ? 'primary' : ''}}" data-id="{{item.id}}" bindtap="selectEntrance">{{item.name}}</button></view>
    <block wx:if="{{entrance}}"><button bindtap="chooseEntrancePhoto">选择入口照片</button><view wx:if="{{entrance.photo}}" class="entrance-mark" id="entrance-photo" bindtap="markEntrance"><image src="{{entrance.photo}}" mode="widthFix"/><text class="entrance-pin" style="left:{{entranceX}}%;top:{{entranceY}}%;">入口</text></view><text class="note">点击照片圈出入口，在下方写明怎么认。</text><label><text>认准这里</text><textarea value="{{entrance.instruction}}" data-key="instruction" bindinput="entranceField" maxlength="240" auto-height/></label><label><text>照片观察日期（年-月-日）</text><input value="{{entrance.observedOn}}" data-key="observedOn" bindinput="entranceField"/></label><text class="note">{{entrance.source === 'helper' ? '家人提供的指引，尚未现场核实。' : '本人记录的入口，开放情况可能变化。'}}</text><button class="primary" bindtap="saveEntrance">保存私人入口卡</button><button bindtap="removeEntrance">移除这张私人入口卡</button><button wx:if="{{assistance.view}}" bindtap="shareEntrance" disabled="{{assistance.busy}}">把这张入口卡分享给家人</button></block>
  </view>
</view>
