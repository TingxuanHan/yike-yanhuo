page {
  background: #f4f8f7;
  color: #243f48;
  font-family: system-ui, sans-serif;
  font-size: 30rpx;
  line-height: 1.6;
}
.page {
  padding: 28rpx;
}
.brand {
  margin: 16rpx 0 30rpx;
}
.eyebrow {
  font-size: 24rpx;
  color: #146c5d;
  display: block;
}
.title {
  display: block;
  font-size: 42rpx;
  font-weight: 600;
  margin-top: 10rpx;
}
.tabs {
  display: flex;
  gap: 10rpx;
  margin-bottom: 24rpx;
}
.tabs button {
  flex: 1;
  font-size: 25rpx;
  margin: 0;
  padding: 0 8rpx;
  background: #e9efed;
}
.tabs .active,
.primary {
  background: #146c5d !important;
  color: white !important;
}
.section {
  background: white;
  border: 1rpx solid #dce6e2;
  border-radius: 18rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.heading {
  font-size: 36rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 16rpx;
}
.muted {
  display: block;
  color: #64777c;
  font-size: 26rpx;
  margin: 12rpx 0;
}
.section label {
  display: block;
  margin: 22rpx 0;
}
.section input,
.picker {
  border: 1rpx solid #a9bdb5;
  border-radius: 10rpx;
  padding: 16rpx 18rpx;
  min-height: 54rpx;
  margin-top: 10rpx;
  background: #fff;
}
.section button {
  font-size: 28rpx;
  margin: 18rpx 0;
  line-height: 1.6;
  padding: 20rpx 16rpx;
}
.notice,
.error {
  display: block;
  padding: 20rpx;
  margin: 18rpx 0;
  border-radius: 10rpx;
  overflow-wrap: anywhere;
}
.notice {
  background: #e9f3ef;
}
.error {
  background: #fff0ec;
  color: #9f3717;
}
.place {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #dce6e2;
}
.place text {
  display: block;
}
.place-name {
  font-size: 34rpx;
  font-weight: 600;
}
.actions {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.actions button {
  margin: 8rpx 0;
  font-size: 26rpx;
}
.range {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #dce6e2;
}
.range .muted {
  width: 100%;
  margin: 0;
}
.warning {
  display: block;
  margin: 16rpx 0;
  font-size: 26rpx;
}
.switch {
  display: flex !important;
  align-items: center;
  justify-content: space-between;
}
.card-overlay {
  position: fixed;
  inset: 0;
  background: #f4f8f7;
  z-index: 10;
  padding: 28rpx;
  box-sizing: border-box;
}
.card {
  height: 100%;
  box-sizing: border-box;
  font-size: 44rpx;
}
.card text {
  display: block;
  margin: 20rpx 0;
}
.card .muted {
  font-size: 32rpx;
}
.card-title {
  font-size: 54rpx;
  font-weight: 600;
}
.card button {
  font-size: 34rpx;
  margin: 36rpx 0;
}
