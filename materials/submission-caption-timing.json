[
  {
    "scene": "title",
    "start": 0.453,
    "end": 5.311,
    "text": "一刻烟火，从家门口，走进好生活。"
  },
  {
    "scene": "title",
    "start": 5.511,
    "end": 12.218,
    "text": "这是一款把社区体检、日常出行和家人协助连接起来的应用。"
  },
  {
    "scene": "home",
    "start": 13.501,
    "end": 20.483,
    "text": "对居民来说，首页只保留我要出门、常用地点和联系家人。"
  },
  {
    "scene": "home",
    "start": 20.683,
    "end": 26.571,
    "text": "复杂条件按需展开，让第一次使用也能找到下一步。"
  },
  {
    "scene": "community",
    "start": 27.832,
    "end": 34.29,
    "text": "先进入社区体检，选择中心，计算道路上的步行范围。"
  },
  {
    "scene": "community",
    "start": 34.49,
    "end": 42.136,
    "text": "现在展示的是人工构造街区，用来复现河道、桥梁和绕行的影响。"
  },
  {
    "scene": "duration",
    "start": 43.399,
    "end": 50.541,
    "text": "切换五分钟、十分钟、十五分钟，可以看到范围逐步变化。"
  },
  {
    "scene": "duration",
    "start": 50.741,
    "end": 56.933,
    "text": "这些切换复用已有路线，不会反复调用真实地图接口。"
  },
  {
    "scene": "coverage",
    "start": 58.189,
    "end": 66.366,
    "text": "系统统计六类生活设施，并逐点解释菜市场、药店和小学的覆盖情况。"
  },
  {
    "scene": "coverage",
    "start": 66.566,
    "end": 74.772,
    "text": "一公里设施覆盖与十五分钟步行是两种口径，检索不完整时保留数据不足。"
  },
  {
    "scene": "report",
    "start": 76.019,
    "end": 83.656,
    "text": "每份报告保留模式、来源时间、采样和调用统计，也可以导出。"
  },
  {
    "scene": "report",
    "start": 83.856,
    "end": 91.842,
    "text": "没有检索到设施，是需要核查的线索，不能直接当作现实中没有设施。"
  },
  {
    "scene": "algorithm",
    "start": 93.102,
    "end": 99.324,
    "text": "算法先建立粗网格，再把有限测时集中到时间边界。"
  },
  {
    "scene": "algorithm",
    "start": 99.524,
    "end": 107.501,
    "text": "两轮加密共享相邻边，保留孔洞和未知区域；预算不足时明确说明。"
  },
  {
    "scene": "comparison",
    "start": 108.751,
    "end": 115.478,
    "text": "同一批路线换成更慢的步速，就能比较设施数量和可达范围。"
  },
  {
    "scene": "comparison",
    "start": 115.678,
    "end": 123.28,
    "text": "等灯时间是可调整的情景假设，当前没有把它称作实时行人信号。"
  },
  {
    "scene": "trip",
    "start": 124.524,
    "end": 130.531,
    "text": "居民可以把买菜、取药和回家放在同一趟行程里。"
  },
  {
    "scene": "trip",
    "start": 130.731,
    "end": 139.833,
    "text": "时间包括停留与返程，价格依据已记录的同规格商品，缺价和超时直接显示。"
  },
  {
    "scene": "ai",
    "start": 141.085,
    "end": 150.027,
    "text": "这里回看此前真实接口联调的截图：语音先变成可编辑文字，再整理为条件。"
  },
  {
    "scene": "ai",
    "start": 150.227,
    "end": 158.883,
    "text": "本人确认后才带入规划，模型不会直接改路线，也不会凭空补出商品价格。"
  },
  {
    "scene": "notice",
    "start": 160.132,
    "end": 166.579,
    "text": "这份构造反馈说明东门有台阶，标出了观察时间和依据。"
  },
  {
    "scene": "notice",
    "start": 166.779,
    "end": 175.65,
    "text": "推车或希望少走台阶的人，会优先看到相关提醒；没有反馈不等于一定畅通。"
  },
  {
    "scene": "conflict",
    "start": 176.902,
    "end": 184.364,
    "text": "另一份演示反馈认为已经恢复，页面随即显示近期反馈有分歧。"
  },
  {
    "scene": "conflict",
    "start": 184.564,
    "end": 192.07,
    "text": "系统不把空间数量当作独立真人数，也不把投票包装成可靠概率。"
  },
  {
    "scene": "alternative",
    "start": 193.318,
    "end": 199.435,
    "text": "现在比较一个同类地点，重新核算去程和接续路线。"
  },
  {
    "scene": "alternative",
    "start": 199.635,
    "end": 208.887,
    "text": "多走多远、何时回来、哪些价格未知，确认之前都能看清，原安排仍然保留。"
  },
  {
    "scene": "entrance",
    "start": 210.145,
    "end": 216.867,
    "text": "还可以从私人地点簿选择本人确认属于同一家店的另一入口。"
  },
  {
    "scene": "entrance",
    "start": 217.067,
    "end": 224.808,
    "text": "这里用的是明确标注的示例点；更换目的地，不代表自动绕过上报障碍。"
  },
  {
    "scene": "card",
    "start": 226.065,
    "end": 232.412,
    "text": "确认后更新下一站，已经到达的地点和原方案继续保留。"
  },
  {
    "scene": "card",
    "start": 232.612,
    "end": 240.393,
    "text": "重新准备出门卡，断网时仍能查看已保存的入口、地点和路线资料。"
  },
  {
    "scene": "family",
    "start": 241.651,
    "end": 248.768,
    "text": "需要帮助时，发起这一趟的短期协助，家人的建议由本人核对。"
  },
  {
    "scene": "family",
    "start": 248.968,
    "end": 256.554,
    "text": "可以保留原安排，也可以主动结束；跨网络使用需要共同的服务器。"
  },
  {
    "scene": "wechat",
    "start": 257.795,
    "end": 265.587,
    "text": "这些是微信开发者工具中的实际页面静帧，两端共用核心计算与服务。"
  },
  {
    "scene": "wechat",
    "start": 265.787,
    "end": 273.628,
    "text": "使用者已验证原首页手机预览，新增流程和现场体验仍要继续验收。"
  },
  {
    "scene": "real",
    "start": 274.898,
    "end": 281.22,
    "text": "现在回放上海抚顺路社区至美城菜市场的真实接口结果。"
  },
  {
    "scene": "real",
    "start": 281.42,
    "end": 291.036,
    "text": "去程二百四十八米，地图参考二百三十二秒，三条文字指引；入口和通行仍待实走。"
  },
  {
    "scene": "validation",
    "start": 292.299,
    "end": 301.15,
    "text": "上海二十四点对照，十五分钟加密轮廓判断正确二十三点，直线圆为十六点。"
  },
  {
    "scene": "validation",
    "start": 301.35,
    "end": 310.407,
    "text": "五分钟并未全面改善；另一组固定点也只净减少一个错误，材料保留了完整计数。"
  },
  {
    "scene": "closing",
    "start": 311.645,
    "end": 317.857,
    "text": "当前一百八十四项业务测试和三十四项浏览器流程通过。"
  },
  {
    "scene": "closing",
    "start": 318.057,
    "end": 329.187,
    "text": "源码采用MIT许可，附依赖清单、贡献规范和维护计划；下一步先补现场证据，再扩大服务。"
  }
]
