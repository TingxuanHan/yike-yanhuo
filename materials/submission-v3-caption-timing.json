[
  {
    "scene": "title",
    "start": 0.4,
    "end": 5.464,
    "text": "一刻烟火，让十五分钟的步行，连起身边的日常。"
  },
  {
    "scene": "title",
    "start": 5.664,
    "end": 15.648,
    "text": "本项目来自南京大学，负责人韩庭轩，团队成员姜可，参加开源人工智能工具赛道的百度地图赛题。"
  },
  {
    "scene": "locate",
    "start": 17.063,
    "end": 22.631,
    "text": "今天，我们选择上海市杨浦区的抚顺路社区睦邻中心。"
  },
  {
    "scene": "locate",
    "start": 22.831,
    "end": 29.575,
    "text": "输入地址，调用百度地址解析，再在真实地图上查看分析起点。"
  },
  {
    "scene": "analyze",
    "start": 30.985,
    "end": 38.185,
    "text": "点击开始体检，后台实际检索六类生活设施，并逐批请求步行路线。"
  },
  {
    "scene": "analyze",
    "start": 38.385,
    "end": 49.329,
    "text": "系统先铺设采样网格，再把有限的加密点用在时间边界附近。画面保留请求和完成过程，中间等待已剪短。"
  },
  {
    "scene": "range",
    "start": 51.729,
    "end": 57.417,
    "text": "同一份实测结果，可以切换五分钟、十分钟和十五分钟。"
  },
  {
    "scene": "range",
    "start": 57.617,
    "end": 65.345,
    "text": "轮廓跟随道路测时变化。切换时长复用已有数据，不再重复调用接口。"
  },
  {
    "scene": "places",
    "start": 66.759,
    "end": 73.911,
    "text": "选择地图上的设施，就能查看名称、地址和本次接口返回的步行时间。"
  },
  {
    "scene": "places",
    "start": 74.111,
    "end": 80.327,
    "text": "居民找地方，社区看服务分布，都从同一份有来源的结果出发。"
  },
  {
    "scene": "coverage",
    "start": 81.739,
    "end": 86.419,
    "text": "进一步检查菜市场、药店和小学的一公里覆盖。"
  },
  {
    "scene": "coverage",
    "start": 86.619,
    "end": 97.251,
    "text": "检索不完整时保留资料不足；发现候选缺口后，还可以预览用量，定向补查，避免把没有查到直接当成没有。"
  },
  {
    "scene": "planning",
    "start": 98.656,
    "end": 106.24,
    "text": "补点工具比较一到三处候选位置，计算补足的原有缺口，并扣除重复覆盖。"
  },
  {
    "scene": "planning",
    "start": 106.44,
    "end": 115.92,
    "text": "同一方案还能放进不同步速和等待条件中比较。缺少证据、没有收益的情况，也会如实保留。"
  },
  {
    "scene": "personal",
    "start": 117.325,
    "end": 125.365,
    "text": "生活圈也应该适合不同的人。放慢步速，或者调整出门时间，就能重新试算。"
  },
  {
    "scene": "personal",
    "start": 125.565,
    "end": 133.605,
    "text": "等灯时间由用户设置，所有个人条件计算复用已测路线，便于解释，也节省调用。"
  },
  {
    "scene": "daily",
    "start": 135.009,
    "end": 142.785,
    "text": "接下来用构造街区演练日常流程：把买菜、取药和返程放进同一趟计划。"
  },
  {
    "scene": "daily",
    "start": 142.985,
    "end": 151.313,
    "text": "可结合停留、营业时间和自己的价格记录比较安排，还能沿途安排轻松步行与歇脚。"
  },
  {
    "scene": "family",
    "start": 152.714,
    "end": 161.234,
    "text": "简易模式保留出门、常用地点和联系家人。不会操作时，可以主动请家人给建议。"
  },
  {
    "scene": "family",
    "start": 161.434,
    "end": 171.25,
    "text": "定位需要本人授权；没有新定位时，显示最近记录的时间和估计范围，帮助家人判断信息是否过时。"
  },
  {
    "scene": "mini",
    "start": 172.661,
    "end": 177.845,
    "text": "相同的规划逻辑，也运行在微信原生小程序中。"
  },
  {
    "scene": "mini",
    "start": 178.045,
    "end": 188.725,
    "text": "有服务器时，网页和小程序通过设备配对同步私人地点与出行偏好；语音识别后保留文字，确认后才规划。"
  },
  {
    "scene": "finish",
    "start": 190.139,
    "end": 198.947,
    "text": "从真实地图体检，到有依据的规划，再到家人协助，一刻烟火把社区服务接到日常出门。"
  },
  {
    "scene": "finish",
    "start": 199.147,
    "end": 206.419,
    "text": "完整代码、运行说明和测试已经公开，欢迎从一个熟悉的社区开始体验。"
  }
]
