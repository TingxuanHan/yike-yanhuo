[
  {
    "scene": "title",
    "start": 0.4,
    "end": 5.464,
    "text": "一刻烟火，让十五分钟的步行，连起身边的日常。"
  },
  {
    "scene": "title",
    "start": 5.664,
    "end": 15.648,
    "text": "本项目来自南京大学，负责人韩庭轩，团队成员姜可，参加开源人工智能工具赛道的百度地图赛题。"
  },
  {
    "scene": "simple",
    "start": 17.36,
    "end": 27.608,
    "text": "第一次打开，只要选择出门、常用地点或联系家人。完整版保留社区体检，大字模式照顾阅读需要。"
  },
  {
    "scene": "locate",
    "start": 29.52,
    "end": 35.088,
    "text": "今天，我们选择上海市杨浦区的抚顺路社区睦邻中心。"
  },
  {
    "scene": "locate",
    "start": 35.288,
    "end": 42.032,
    "text": "输入地址，调用百度地址解析，再在真实地图上查看分析起点。"
  },
  {
    "scene": "analyze",
    "start": 43.72,
    "end": 50.92,
    "text": "点击开始体检，后台实际检索六类生活设施，并逐批请求步行路线。"
  },
  {
    "scene": "analyze",
    "start": 51.12,
    "end": 62.064,
    "text": "系统先铺设采样网格，再把有限的加密点用在时间边界附近。画面保留请求和完成过程，中间等待已剪短。"
  },
  {
    "scene": "range",
    "start": 63.8,
    "end": 69.488,
    "text": "同一份实测结果，可以切换五分钟、十分钟和十五分钟。"
  },
  {
    "scene": "range",
    "start": 69.688,
    "end": 77.416,
    "text": "轮廓跟随道路测时变化。切换时长复用已有数据，不再重复调用接口。"
  },
  {
    "scene": "places",
    "start": 79.12,
    "end": 86.272,
    "text": "选择地图上的设施，就能查看名称、地址和本次接口返回的步行时间。"
  },
  {
    "scene": "places",
    "start": 86.472,
    "end": 92.688,
    "text": "居民找地方，社区看服务分布，都从同一份有来源的结果出发。"
  },
  {
    "scene": "algorithm",
    "start": 94.4,
    "end": 99.824,
    "text": "先建粗网格，再把有限路线测时集中到时间边界。"
  },
  {
    "scene": "algorithm",
    "start": 100.024,
    "end": 108.832,
    "text": "两轮加密复用相邻共享边；串行队列、缓存与预算贯穿两端，孔洞和未知继续保留。"
  },
  {
    "scene": "coverage",
    "start": 110.56,
    "end": 115.24,
    "text": "进一步检查菜市场、药店和小学的一公里覆盖。"
  },
  {
    "scene": "coverage",
    "start": 115.44,
    "end": 126.072,
    "text": "检索不完整时保留资料不足；发现候选缺口后，还可以预览用量，定向补查，避免把没有查到直接当成没有。"
  },
  {
    "scene": "review",
    "start": 127.76,
    "end": 136.928,
    "text": "设施也会变化。保留观察来源、核查依据与复核日期，冲突先提示，修改可以撤销。"
  },
  {
    "scene": "repair",
    "start": 138.84,
    "end": 147.456,
    "text": "选择最多三项缺失数据，执行前先看调用上限；这里使用零外部请求的模拟演练。"
  },
  {
    "scene": "repair",
    "start": 147.656,
    "end": 153.776,
    "text": "结果先比较、再由用户采用，原报告和恢复入口继续保留。"
  },
  {
    "scene": "siting",
    "start": 155.48,
    "end": 160.784,
    "text": "从已有测时点选一到三处，枚举最多七种补点方案。"
  },
  {
    "scene": "siting",
    "start": 160.984,
    "end": 168.784,
    "text": "同数量之间比较补足的原缺口，组合扣除重叠；未知区域不能算成已经改善。"
  },
  {
    "scene": "conditions",
    "start": 170.52,
    "end": 176.928,
    "text": "换成较慢步速、另一时段和假设等待，检查方案是否仍合适。"
  },
  {
    "scene": "conditions",
    "start": 177.128,
    "end": 185.096,
    "text": "共同补足取三组几何的空间交集；取舍指标不是成功概率，也不是全局最优。"
  },
  {
    "scene": "detour",
    "start": 186.8,
    "end": 192.992,
    "text": "已有路线里，直线近而路程长的点，会进入绕行核查清单。"
  },
  {
    "scene": "detour",
    "start": 193.192,
    "end": 201.448,
    "text": "页面保留路线距离、额外路程与来源；这些是核查线索，不能当作已经确认的障碍。"
  },
  {
    "scene": "audit",
    "start": 203.16,
    "end": 211.944,
    "text": "先固定六个位置及原预测，再读取构造路网测时，对照当前轮廓、粗网格和直线圆。"
  },
  {
    "scene": "audit",
    "start": 212.144,
    "end": 220.76,
    "text": "切到五分钟重做，轮廓也会漏判。逐点依据可以导出，原轮廓不会被复核结果改写。"
  },
  {
    "scene": "report",
    "start": 222.48,
    "end": 228.696,
    "text": "报告保存模式、来源时间、采样、调用统计与完整数据。"
  },
  {
    "scene": "report",
    "start": 228.896,
    "end": 235.136,
    "text": "导出的补查、补点和抽点依据，还能交给独立脚本重新计算。"
  },
  {
    "scene": "personal",
    "start": 236.84,
    "end": 244.88,
    "text": "生活圈也应该适合不同的人。放慢步速，或者调整出门时间，就能重新试算。"
  },
  {
    "scene": "personal",
    "start": 245.08,
    "end": 253.12,
    "text": "等灯时间由用户设置，所有个人条件计算复用已测路线，便于解释，也节省调用。"
  },
  {
    "scene": "placebook",
    "start": 254.84,
    "end": 265.856,
    "text": "小店没有被地图收录，也能记下入口、照片、地标和到访日期。大字地点卡可朗读、打印和短期分享。"
  },
  {
    "scene": "calibration",
    "start": 267.76,
    "end": 279.64,
    "text": "先固定预计时间，走完再记录用时和停留。至少三条有效记录才给步速建议，后续记录继续检验，采用前本人确认。"
  },
  {
    "scene": "daily",
    "start": 281.56,
    "end": 289.336,
    "text": "接下来用构造街区演练日常流程：把买菜、取药和返程放进同一趟计划。"
  },
  {
    "scene": "daily",
    "start": 289.536,
    "end": 297.864,
    "text": "可结合停留、营业时间和自己的价格记录比较安排，还能沿途安排轻松步行与歇脚。"
  },
  {
    "scene": "familiar",
    "start": 299.56,
    "end": 310.816,
    "text": "熟悉的路可以存成照片卡。需要歇脚时，按连续步行上限安排休息点，推车和少走台阶的需要也纳入规划。"
  },
  {
    "scene": "shopping",
    "start": 312.72,
    "end": 324.528,
    "text": "同规格商品比价格，多家店比较少走、少花和均衡安排。实付、缺货与过期记录分开显示，缺价就保留未知。"
  },
  {
    "scene": "movement",
    "start": 326.44,
    "end": 337.72,
    "text": "沿办事路线安排轻快交替、歇脚和返程。时间不够或步行目标没达到会明确提示，计划不当成实际运动。"
  },
  {
    "scene": "ai_settings",
    "start": 339.64,
    "end": 350.44,
    "text": "可以使用基础服务或自定义模型接口，也能离线手填条件。密钥交给服务端保管，模型草稿确认后才应用。"
  },
  {
    "scene": "voice",
    "start": 352.36,
    "end": 360.424,
    "text": "这两张归档截图来自此前真实接口联调：语音变成可编辑文字，再整理为条件。"
  },
  {
    "scene": "voice",
    "start": 360.624,
    "end": 369.84,
    "text": "本人确认后才应用，模型不编造路线、价格和营业状态；这段语音与模型联调使用历史留档。"
  },
  {
    "scene": "notice",
    "start": 371.56,
    "end": 377.224,
    "text": "这份构造反馈说东门有台阶，标出了观察时间与依据。"
  },
  {
    "scene": "notice",
    "start": 377.424,
    "end": 385.128,
    "text": "有推车或少走台阶需要的人优先看到相关提醒；没有反馈不代表一定畅通。"
  },
  {
    "scene": "conflict",
    "start": 386.84,
    "end": 393.104,
    "text": "另一份演示反馈认为已经恢复，页面显示近期反馈有分歧。"
  },
  {
    "scene": "conflict",
    "start": 393.304,
    "end": 400.168,
    "text": "系统不把空间数量当作独立真人数，也不把投票包装成可靠概率。"
  },
  {
    "scene": "alternative",
    "start": 401.88,
    "end": 406.56,
    "text": "选择同类地点，重新核算去程与接续路线。"
  },
  {
    "scene": "alternative",
    "start": 406.76,
    "end": 414.752,
    "text": "多走多远、何时回来、哪些价格未知，确认之前都能看清，原安排仍然保留。"
  },
  {
    "scene": "entrance",
    "start": 416.48,
    "end": 421.712,
    "text": "也可选择本人记录并确认属于同一家店的另一入口。"
  },
  {
    "scene": "entrance",
    "start": 421.912,
    "end": 427.912,
    "text": "这里明确使用示例点；更换入口不代表自动绕过上报障碍。"
  },
  {
    "scene": "walking",
    "start": 429.6,
    "end": 435.096,
    "text": "回放上海抚顺路社区至美城菜市场的真实接口结果。"
  },
  {
    "scene": "walking",
    "start": 435.296,
    "end": 443.96,
    "text": "去程二百四十八米，地图参考二百三十二秒，三条文字指引；入口和通行仍待实走。"
  },
  {
    "scene": "card",
    "start": 445.68,
    "end": 451.344,
    "text": "确认后更新下一站，已经到达的地点和原方案继续保留。"
  },
  {
    "scene": "card",
    "start": 451.544,
    "end": 458.72,
    "text": "重新准备出门卡，断网时还能查看已保存的地点、入口和路线资料。"
  },
  {
    "scene": "family",
    "start": 460.44,
    "end": 468.96,
    "text": "简易模式保留出门、常用地点和联系家人。不会操作时，可以主动请家人给建议。"
  },
  {
    "scene": "family",
    "start": 469.16,
    "end": 478.976,
    "text": "定位需要本人授权；没有新定位时，显示最近记录的时间和估计范围，帮助家人判断信息是否过时。"
  },
  {
    "scene": "location",
    "start": 480.68,
    "end": 491.528,
    "text": "位置只在本人授权时获取。拒绝定位仍可看最近记录的时间和估计范围；家人主动回应，位置卡可以撤销。"
  },
  {
    "scene": "sync",
    "start": 493.44,
    "end": 504.6,
    "text": "设备配对后同步地点、偏好和报告。冲突先保留本机草稿，再选择合并或替换；私人备份可导出和恢复。"
  },
  {
    "scene": "mini",
    "start": 506.52,
    "end": 511.704,
    "text": "相同的规划逻辑，也运行在微信原生小程序中。"
  },
  {
    "scene": "mini",
    "start": 511.904,
    "end": 522.584,
    "text": "有服务器时，网页和小程序通过设备配对同步私人地点与出行偏好；语音识别后保留文字，确认后才规划。"
  },
  {
    "scene": "finish",
    "start": 524.28,
    "end": 533.088,
    "text": "从真实地图体检，到有依据的规划，再到家人协助，一刻烟火把社区服务接到日常出门。"
  },
  {
    "scene": "finish",
    "start": 533.288,
    "end": 540.56,
    "text": "完整代码、运行说明和测试已经公开，欢迎从一个熟悉的社区开始体验。"
  }
]
