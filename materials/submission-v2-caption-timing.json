[
  {
    "scene": "title",
    "start": 0.452,
    "end": 5.31,
    "text": "一刻烟火，从家门口，走进好生活。"
  },
  {
    "scene": "title",
    "start": 5.51,
    "end": 12.092,
    "text": "沿道路看见生活圈，把社区问题接到有依据的核查与行动。"
  },
  {
    "scene": "home",
    "start": 13.365,
    "end": 18.982,
    "text": "居民首页保留我要出门、常用地点和联系家人。"
  },
  {
    "scene": "home",
    "start": 19.182,
    "end": 24.785,
    "text": "复杂条件按需展开，第一次使用也能找到下一步。"
  },
  {
    "scene": "community",
    "start": 26.049,
    "end": 32.267,
    "text": "进入社区体检，选择中心，计算道路上的步行范围。"
  },
  {
    "scene": "community",
    "start": 32.467,
    "end": 40.289,
    "text": "这里是人工构造街区，复现河道、桥梁与绕行，不冒充真实社区。"
  },
  {
    "scene": "duration",
    "start": 41.557,
    "end": 48.25,
    "text": "切换五分钟、十分钟、十五分钟，范围随道路展开。"
  },
  {
    "scene": "duration",
    "start": 48.45,
    "end": 54.207,
    "text": "切换复用已有测时，不重复请求真实地图接口。"
  },
  {
    "scene": "coverage",
    "start": 55.474,
    "end": 62.706,
    "text": "六类生活设施中，菜市场、药店和小学分别检查一公里覆盖。"
  },
  {
    "scene": "coverage",
    "start": 62.906,
    "end": 71.002,
    "text": "连续分区把已找到设施、候选缺口和资料不足分开；它不是人口覆盖率。"
  },
  {
    "scene": "repair",
    "start": 72.274,
    "end": 81.67,
    "text": "选择最多三项缺失数据，执行前先看调用上限；这里使用零外部请求的模拟演练。"
  },
  {
    "scene": "repair",
    "start": 81.87,
    "end": 88.867,
    "text": "结果先比较、再由用户采用，原报告和恢复入口继续保留。"
  },
  {
    "scene": "siting",
    "start": 90.121,
    "end": 96.308,
    "text": "从已有测时点选一到三处，枚举最多七种补点方案。"
  },
  {
    "scene": "siting",
    "start": 96.508,
    "end": 105.214,
    "text": "同数量之间比较补足的原缺口，组合扣除重叠；未知区域不能算成已经改善。"
  },
  {
    "scene": "conditions",
    "start": 106.471,
    "end": 113.703,
    "text": "换成较慢步速、另一时段和假设等待，检查方案是否仍合适。"
  },
  {
    "scene": "conditions",
    "start": 113.903,
    "end": 122.499,
    "text": "共同补足取三组几何的空间交集；取舍指标不是成功概率，也不是全局最优。"
  },
  {
    "scene": "detour",
    "start": 123.753,
    "end": 130.58,
    "text": "已有路线里，直线近而路程长的点，会进入绕行核查清单。"
  },
  {
    "scene": "detour",
    "start": 130.78,
    "end": 140.136,
    "text": "页面保留路线距离、额外路程与来源；这些是核查线索，不能当作已经确认的障碍。"
  },
  {
    "scene": "audit",
    "start": 141.409,
    "end": 151.03,
    "text": "先固定六个位置及原预测，再读取构造路网测时，对照当前轮廓、粗网格和直线圆。"
  },
  {
    "scene": "audit",
    "start": 151.23,
    "end": 161.181,
    "text": "切到五分钟重做，轮廓也会漏判。逐点依据可以导出，原轮廓不会被复核结果改写。"
  },
  {
    "scene": "report",
    "start": 162.442,
    "end": 169.444,
    "text": "报告保存模式、来源时间、采样、调用统计与完整数据。"
  },
  {
    "scene": "report",
    "start": 169.644,
    "end": 176.636,
    "text": "导出的补查、补点和抽点依据，还能交给独立脚本重新计算。"
  },
  {
    "scene": "algorithm",
    "start": 177.888,
    "end": 183.875,
    "text": "先建粗网格，再把有限路线测时集中到时间边界。"
  },
  {
    "scene": "algorithm",
    "start": 184.075,
    "end": 193.946,
    "text": "两轮加密复用相邻共享边；串行队列、缓存与预算贯穿两端，孔洞和未知继续保留。"
  },
  {
    "scene": "comparison",
    "start": 195.207,
    "end": 201.859,
    "text": "同一批路线换成更慢步速，就能比较设施数量和可达范围。"
  },
  {
    "scene": "comparison",
    "start": 202.059,
    "end": 208.671,
    "text": "等灯时间由用户设定情景，当前没有接入实时行人信号。"
  },
  {
    "scene": "trip",
    "start": 209.923,
    "end": 218.45,
    "text": "日常出行把买菜、取药和返程放进同一趟计划，也可顺便安排步行目标。"
  },
  {
    "scene": "trip",
    "start": 218.65,
    "end": 227.751,
    "text": "时间包括停留与返程，价格依据已记录的同规格商品；缺价和超时直接显示。"
  },
  {
    "scene": "ai",
    "start": 229.008,
    "end": 238.154,
    "text": "这两张归档截图来自此前真实接口联调：语音变成可编辑文字，再整理为条件。"
  },
  {
    "scene": "ai",
    "start": 238.354,
    "end": 247.591,
    "text": "本人确认后才应用，模型不编造路线、价格和营业状态；本次录制不重调接口。"
  },
  {
    "scene": "notice",
    "start": 248.834,
    "end": 255.006,
    "text": "这份构造反馈说东门有台阶，标出了观察时间与依据。"
  },
  {
    "scene": "notice",
    "start": 255.206,
    "end": 263.487,
    "text": "有推车或少走台阶需要的人优先看到相关提醒；没有反馈不代表一定畅通。"
  },
  {
    "scene": "conflict",
    "start": 264.74,
    "end": 271.687,
    "text": "另一份演示反馈认为已经恢复，页面显示近期反馈有分歧。"
  },
  {
    "scene": "conflict",
    "start": 271.887,
    "end": 279.394,
    "text": "系统不把空间数量当作独立真人数，也不把投票包装成可靠概率。"
  },
  {
    "scene": "alternative",
    "start": 280.661,
    "end": 285.949,
    "text": "选择同类地点，重新核算去程与接续路线。"
  },
  {
    "scene": "alternative",
    "start": 286.149,
    "end": 295.4,
    "text": "多走多远、何时回来、哪些价格未知，确认之前都能看清，原安排仍然保留。"
  },
  {
    "scene": "entrance",
    "start": 296.651,
    "end": 302.368,
    "text": "也可选择本人记录并确认属于同一家店的另一入口。"
  },
  {
    "scene": "entrance",
    "start": 302.568,
    "end": 309.045,
    "text": "这里明确使用示例点；更换入口不代表自动绕过上报障碍。"
  },
  {
    "scene": "card",
    "start": 310.308,
    "end": 316.655,
    "text": "确认后更新下一站，已经到达的地点和原方案继续保留。"
  },
  {
    "scene": "card",
    "start": 316.855,
    "end": 324.616,
    "text": "重新准备出门卡，断网时还能查看已保存的地点、入口和路线资料。"
  },
  {
    "scene": "family",
    "start": 325.878,
    "end": 332.835,
    "text": "需要帮助时，发起这一趟的短期协助，家人建议由本人核对。"
  },
  {
    "scene": "family",
    "start": 333.035,
    "end": 339.822,
    "text": "可以保留原安排或主动结束；跨网络协助需要共同的服务器。"
  },
  {
    "scene": "wechat",
    "start": 341.092,
    "end": 349.893,
    "text": "这里是微信开发者工具中的实际静帧，包含简易首页、多条件比较与抽点复核。"
  },
  {
    "scene": "wechat",
    "start": 350.093,
    "end": 358.59,
    "text": "两端共用计算和服务；原首页手机预览已确认，新增流程仍需手机验收。"
  },
  {
    "scene": "real",
    "start": 359.874,
    "end": 365.686,
    "text": "回放上海抚顺路社区至美城菜市场的真实接口结果。"
  },
  {
    "scene": "real",
    "start": 365.886,
    "end": 375.502,
    "text": "去程二百四十八米，地图参考二百三十二秒，三条文字指引；入口和通行仍待实走。"
  },
  {
    "scene": "validation",
    "start": 376.76,
    "end": 387.206,
    "text": "历史二十四点对照，十五分钟加密轮廓一致二十三点，直线圆十六点；五分钟没有全面改善。"
  },
  {
    "scene": "validation",
    "start": 387.406,
    "end": 399.016,
    "text": "本次六点重复接口核对使用六条路线，轮廓六点一致、直线圆四点；它不是新独立测试集或现场真值。"
  },
  {
    "scene": "governance",
    "start": 400.274,
    "end": 410.095,
    "text": "按百度四项指标组织证据：功能四十，接口与工程三十，体验十五，开源规范十五。"
  },
  {
    "scene": "governance",
    "start": 410.295,
    "end": 421.036,
    "text": "附许可、依赖、贡献流程和维护计划；仓库仍为私有，提交前需落实评审访问与公开方式。"
  },
  {
    "scene": "closing",
    "start": 422.291,
    "end": 429.058,
    "text": "功能基线通过二百四十四项业务测试和四十四项浏览器流程。"
  },
  {
    "scene": "closing",
    "start": 429.258,
    "end": 439.918,
    "text": "完整源码、十八页介绍与本片一起交付。下一步先补现场和手机证据，再开展小范围试用。"
  }
]
