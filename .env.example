# Browser key: restrict its Referer list in the Baidu console.
BAIDU_BROWSER_AK=
# Server key: restrict its public egress IP; never use a VITE_ prefix.
BAIDU_SERVER_AK=
HOST=127.0.0.1
PORT=8787
# Route pairs per second, not HTTP requests per second.
# Default 1; values above 2 are rejected to retain headroom below 3 QPS.
BAIDU_ROUTE_QPS=1
# Minimum 2000 ms between place searches; all Web API requests are serialized.
BAIDU_SEARCH_INTERVAL_MS=2000
BAIDU_MAX_ROUTE_PAIRS=260
BAIDU_MAX_SEARCH_PAGES=1
# Process-local daily safeguards; the Baidu console remains authoritative.
BAIDU_DAILY_ROUTE_LIMIT=500
BAIDU_DAILY_SEARCH_LIMIT=12
