# Browser key: restrict its Referer list in the Baidu console.
BAIDU_BROWSER_AK=
# Server key: restrict its public egress IP; never use a VITE_ prefix.
BAIDU_SERVER_AK=
HOST=127.0.0.1
PORT=8787
# Route pairs per second, not HTTP requests per second.
# Default 1; values above 2 are rejected to retain headroom below 3 QPS.
BAIDU_ROUTE_QPS=1
# Minimum 2000 ms between place searches; all Web API requests are serialized.
BAIDU_SEARCH_INTERVAL_MS=2000
BAIDU_MAX_ROUTE_PAIRS=260
BAIDU_MAX_SEARCH_PAGES=1
# Project-local daily safeguards; the Baidu console remains authoritative.
BAIDU_DAILY_ROUTE_LIMIT=500
BAIDU_DAILY_SEARCH_LIMIT=12
# Private place books. This directory must persist across server restarts.
PERSONAL_DATA_PATH=.data/life.sqlite
# External access requires an HTTPS origin and an administrator invitation.
PUBLIC_ORIGIN=
# Set to a random value of at least 24 characters for private-space creation.
SPACE_INVITE_CODE=

# Optional model service. Verify the model is free in the provider console before enabling.
AI_FREE_BASE_URL=https://api.siliconflow.cn/v1
AI_FREE_MODEL=Qwen/Qwen3-8B
AI_FREE_KEY=
# false disables local daily caps and requires a fresh zero-price check on SiliconFlow before each call.
AI_FREE_LOCAL_LIMITS=true
AI_FREE_SPACE_DAILY=3
AI_FREE_DAILY_REQUESTS=20
# Conservative input/output reservation, not the vendor billing-token counter.
AI_FREE_DAILY_TOKEN_BUDGET=60000
AI_OWN_DEVICE_DAILY=20
# Comma-separated additional HTTPS hostnames, without scheme/path/port.
AI_ALLOWED_HOSTS=
# Defaults to PERSONAL_DATA_PATH + .ai, with a sibling .key file. Back up both.
AI_DATA_PATH=
# Optional 64-hex-character secret. Otherwise a private local key file is created.
AI_ENCRYPTION_KEY=
